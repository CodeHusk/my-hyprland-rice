# #######################################################################################
# CUSTOM THINKPAD HYPRLAND CONFIG (ENHANCED WITH EYECANDY + SWALLOW + FASTER)
# OPTIMIZED FOR THINKPAD T470 – 1920x1080@60Hz, Intel HD 520
# #######################################################################################

################
### MONITORS ###
################
# Integer scaling to reduce rendering overhead
monitor = eDP-1, 1920x1080@60, auto, 1.25

xwayland:force_zero_scaling = true
xwayland:use_nearest_neighbor = true

###################
### MY PROGRAMS ###
###################
$terminal = kitty
$fileManager = dolphin
$menu = sh -c "GTK_THEME=WofiLime:dark wofi --show drun --location=center --anchor=center"
$lock = hyprlock
$nvim = kitty nvim

################
### AUTOSTART ###
################
exec-once = nm-applet &
exec-once = waybar &
exec-once = awww-daemon & sleep 1 && awww img /home/rudransh/Downloads/summer-scene-with-design.jpg && echo "0" > ~/.config/hypr/wallpaper_index
exec-once = dunst &
exec = /usr/bin/hyprshade on ~/.config/hypr/shaders/blue-light-filter.glsl
exec-once = dbus-update-activation-environment --systemd HYPRLAND_INSTANCE_SIGNATURE
exec-once = gnome-keyring-daemon --start --components=secrets
exec-once = hypridle
exec-once = gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark'
exec-once = gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec-once = systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = sleep 1 && /usr/lib/xdg-desktop-portal-hyprland &

#############################
### ENVIRONMENT VARIABLES ###
#############################
env = XCURSOR_SIZE,24
env = HYPRCURSOR_SIZE,24
env = ELECTRON_OZONE_PLATFORM_HINT,wayland

#####################
### LOOK AND FEEL ###
#####################
general {
    gaps_in = 3
    gaps_out = 6
    border_size = 2
    # Solid color – no animated gradient (saves GPU cycles)
    col.active_border = rgba(00ff99ee)
    col.inactive_border = rgba(595959aa)
    resize_on_border = true
    allow_tearing = false
    layout = dwindle
}

decoration {
    rounding = 10
    rounding_power = 2
    active_opacity = 1.0
    inactive_opacity = 1.0
    shadow {
        enabled = false              # turned off to reduce GPU load
        range = 3
        render_power = 2
        color = rgba(1a1a1aee)
    }
    blur {
        enabled = false              # turned off – biggest performance gain
        size = 4
        passes = 1
        vibrancy = 0.1696
    }
}

# ============================================================
# 🎬 ULTIMATE EYECANDY ANIMATIONS – FASTER + SPECIAL WORKSPACE
# (durations shortened for T470 performance)
# ============================================================
animations {
    enabled = yes, please :)

    # ─── Custom Bezier Curves (unchanged) ─────────────────────────────────
    bezier = easeOutQuint,   0.23, 1,    0.32, 1
    bezier = easeInOutCubic, 0.65, 0.05, 0.36, 1
    bezier = linear,         0,    0,    1,    1
    bezier = almostLinear,   0.5,  0.5,  0.75, 1
    bezier = quick,          0.15, 0,    0.1,  1
    bezier = bounce,         0.34, 1.56, 0.64, 1
    bezier = spring,         0.42, 0.0,  0.58, 1.0
    bezier = smooth,         0.25, 0.1,  0.25, 1
    bezier = snappy,         0.2,  0.9,  0.4,  1.0

    # ─── Global defaults (kept fast multiplier) ───────────────────────────
    animation = global,        1,     8,     default

    # ─── Windows (main events) – Faster speeds ───────────────────────────
    animation = windows,       1,     1.5,   smooth,      popin 85%
    animation = windowsIn,     1,     1.8,   spring,      slide
    animation = windowsOut,    1,     1.5,   easeOutQuint, popin 80%
    animation = windowsMove,   1,     2.0,   easeInOutCubic, slide

    # ─── Layers (bars, notifications, etc.) ───────────────────────────────
    animation = layers,        1,     1.5,   smooth
    animation = layersIn,      1,     1.5,   spring,      fade
    animation = layersOut,     1,     1.2,   easeOutQuint, fade

    # ─── Fade transitions ─────────────────────────────────────────────────
    animation = fade,          1,     2.0,   smooth
    animation = fadeIn,        1,     1.5,   almostLinear
    animation = fadeOut,       1,     1.5,   almostLinear
    animation = fadeLayersIn,  1,     1.5,   almostLinear
    animation = fadeLayersOut, 1,     1.5,   almostLinear

    # ─── Borders (solid color – borderangle animation removed to save GPU) ─
    animation = border,        1,     1.5,   smooth

    # ─── Workspaces (switching with slidefade) – Faster & elastic ────────
    animation = workspaces,    1,     2.5,   spring,      slidefade 20%
    animation = workspacesIn,  1,     2.0,   smooth,      fade
    animation = workspacesOut, 1,     2.0,   smooth,      fade

    # ─── Special Workspace (scratchpad) – Smooth popin ───────────────────
    animation = specialWorkspace, 1, 2.0, spring, slide

    # ─── Zoom factor (when scaling windows) ───────────────────────────────
    animation = zoomFactor,    1,     3.0,   easeOutQuint
}

dwindle {
    pseudotile = yes
    preserve_split = true
}

master {
    new_status = master
}

misc {
    force_default_wallpaper = -1
    disable_hyprland_logo = false

    # ─── Window Swallowing (apps replace the terminal that launched them) ─
    enable_swallow = true
    swallow_regex = ^(kitty|alacritty|foot|wezterm)$
    swallow_exception_regex = ^(firefox|chromium|code)$   # don't swallow these
}

#############
### INPUT ###
#############
input {
    kb_layout = us
    follow_mouse = 1
    sensitivity = 0
    touchpad {
        natural_scroll = false
    }
}

gesture = 3, horizontal, workspace

device {
    name = epic-mouse-v1
    sensitivity = -0.5
}

###################
### KEYBINDINGS ###
###################
$mainMod = SUPER

bind = $mainMod, Q, exec, $terminal
bind = $mainMod, ESCAPE, exec, $lock
bind = $mainMod, C, killactive,
bind = $mainMod, M, exec, command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch exit
bind = $mainMod, D, exec, $fileManager
bind = $mainMod, V, togglefloating,
bind = $mainMod, R, exec, $menu
bind = $mainMod, P, pseudo,
bind = $mainMod, J, layoutmsg, togglesplit
bind = $mainMod, Z, exec, $nvim
# Cinematic wallpaper switch
# Wallpaper cycle with transition picker
bind = $mainMod, W, exec, ~/.config/hypr/wallpaper-swap.sh
bind = ,PRINT, exec, hyprshot.sh

# Focus
bind = $mainMod, left, movefocus, l
bind = $mainMod, right, movefocus, r
bind = $mainMod, up, movefocus, u
bind = $mainMod, down, movefocus, d

# Workspaces
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9
bind = $mainMod, 0, workspace, 10

bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9
bind = $mainMod SHIFT, 0, movetoworkspace, 10

# Special workspace (scratchpad) – now with animation
bind = $mainMod, S, togglespecialworkspace, magic
bind = $mainMod SHIFT, S, movetoworkspace, special:magic

bind = $mainMod, mouse_down, workspace, e+1
bind = $mainMod, mouse_up, workspace, e-1

bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow

# Multimedia Keys (Volume & Brightness)
bindel = ,XF86AudioRaiseVolume, exec, wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+
bindel = ,XF86AudioLowerVolume, exec, wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%-
bindl = ,XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindel = ,XF86AudioMicMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindel = ,XF86MonBrightnessUp, exec, brightnessctl -e4 -n2 set 5%+
bindel = ,XF86MonBrightnessDown, exec, brightnessctl -e4 -n2 set 5%-

# Media Playback
bindl = ,XF86AudioNext, exec, playerctl next
bindl = ,XF86AudioPause, exec, playerctl play-pause
bindl = ,XF86AudioPlay, exec, playerctl play-pause
bindl = ,XF86AudioPrev, exec, playerctl previous

##############################
### WINDOWS AND WORKSPACES ###
##############################
windowrule {
    name = suppress-maximize-events
    match:class = .*
    suppress_event = maximize
}

windowrule {
    name = fix-xwayland-drags
    match:class = ^$
    match:title = ^$
    match:xwayland = true
    match:float = true
    match:fullscreen = false
    match:pin = false
    no_focus = true
}

windowrule {
    name = move-hyprland-run
    match:class = hyprland-run
    move = 20 monitor_h-120
    float = yes
}
